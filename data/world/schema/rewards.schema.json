{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stasiumxii.local/schemas/world_rewards.v2.json",
  "title": "Stasium PC world rewards",
  "description": "Sidecar stasium.world_rewards version 2. Crypto Coins, the mobile gear chests mapped onto PC sources, Mystery Boxes, loose items, dungeon rows and star_drops. The set parts live in backend/pc_gear.gd.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "format_version", "status", "coins", "carry", "gear", "items",
    "dungeons", "box", "mission_ranks", "legacy_gear"
  ],
  "properties": {
    "format": {"const": "stasium.world_rewards"},
    "format_version": {"const": 2},
    "status": {"const": "proposed"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "coins": {"type": "object"},
    "carry": {"type": "object"},
    "weights": {"type": "object"},
    "classes": {"type": "array", "items": {"type": "string"}},
    "gear_slots": {"type": "array", "items": {"type": "string"}},
    "equip_slots": {"type": "array", "items": {"type": "string"}},
    "gear": {"type": "object"},
    "legacy_gear": {"type": "object"},
    "rarity_colors": {"type": "object"},
    "mission_ranks": {"type": "array"},
    "box": {"type": "array"},
    "dungeon_box_by_stars": {"type": "object"},
    "items": {"type": "array"},
    "dungeons": {"type": "array"}
  }
}
