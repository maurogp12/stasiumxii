{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stasiumxii.local/schemas/world_missions.v1.json",
  "title": "Stasium PC world missions",
  "description": "Sidecar stasium.world_missions version 1. Section 4.7. The loader is the strict check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "status", "notes", "reach_index", "missions"],
  "properties": {
    "format": {"const": "stasium.world_missions"},
    "format_version": {"const": 1},
    "status": {"const": "proposed"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reach_index": {
      "type": "array",
      "items": {"type": "object"}
    },
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  }
}
