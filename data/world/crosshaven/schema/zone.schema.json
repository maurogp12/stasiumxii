    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "format": {
      "const": "stasium.zone"
    },
    "format_version": {
      "const": 1
    },
    "zone_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable chunk id. Crosshaven files use the crosshaven_ prefix."
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "spawn": {
      "$ref": "#/$defs/cell"
    },
    "points_of_interest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "town",
              "crossroads",
              "landmark"
            ]
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "edge",
          "target_zone",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "edge": {
            "enum": [
              "north",
              "south",
              "east",
              "west"
            ]
          },
          "target_zone": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "$ref": "#/$defs/cell"
                },
                "to": {
                  "$ref": "#/$defs/cell"
                }
              }
            }
          }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "blocks",
          "origin",
          "footprint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Instance id, unique inside the chunk. Not the sprite name."
          },
          "type": {
            "description": "Sprite id. Must be a propCatalog id. Footprint cells must equal origin plus that id's offsets.",
            "enum": [
              "tree",
              "fence",
              "red_roof_cottage",
              "northgate_spire",
              "stoneford_spire",
              "eastmarch_spire",
              "westwatch_spire",
              "southbridge_spire",
              "crossroads_centerpiece",
              "barn_2x2",
              "farmhouse_2x2",
              "windmill_2x2_body",
              "bakery_2x2",
              "smithy_2x2",
              "tavern_3x2",
              "fountain_2x2",
              "watermill_2x2_body",
              "watchtower_2x2",
              "fishing_hut_2x2",
              "market_stall",
              "cart",
              "scarecrow",
              "farm_fence_nesw",
              "farm_fence_nwse",
              "hedgerow_nesw",
              "hedgerow_nwse",
              "lamp_post",
              "well",
              "hay_bale",
              "waystone",
              "wall_tower",
              "stone_wall_high_nwse",
              "stone_wall_high_nesw",
              "quarry_rocks_a",
              "net_rack",
              "rowboat",
              "crate_apples",
              "signpost_crossroads",
              "brazier",
              "tree_apple",
              "haystack",
              "barrel",
              "tree_cluster_2x2_a"
            ]
          },
          "blocks": {
            "type": "boolean",
            "description": "When true, every footprint cell blocks walking. When false, the prop is visual only."
          },
          "origin": {
            "$ref": "#/$defs/cell"
          },
          "footprint": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/cell"
            }
          }
        }
      }
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "description": "Row-major, y then x, one record per cell. Length must equal width * height.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "terrain",
          "walkable",
          "height"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "terrain": {
            "enum": [
              "golden_plains",
              "dirt_road",
              "water",
              "cliff",
              "farm_cabbage",
              "farm_carrot",
              "farm_fallow",
              "farm_lavender",
              "farm_plowed",
              "farm_pumpkin",
              "farm_soil",
              "farm_sunflower"
            ]
          },
          "walkable": {
            "type": "boolean"
          },
          "height": {
            "type": "integer",
            "minimum": 0,
            "description": "Height in steps. One step is 10 px in BoardVisualSort. Not pixels."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "terrain": {
                  "enum": [
                    "golden_plains",
                    "dirt_road",
                    "farm_cabbage",
                    "farm_carrot",
                    "farm_fallow",
                    "farm_lavender",
                    "farm_plowed",
                    "farm_pumpkin",
                    "farm_soil",
                    "farm_sunflower"
                  ]
                }
              },
              "required": [
                "terrain"
              ]
            },
            "then": {
              "properties": {
                "walkable": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "terrain": {
                  "enum": [
                    "water",
                    "cliff"
                  ]
                }
              },
              "required": [
                "terrain"
              ]
            },
            "then": {
              "properties": {
                "walkable": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "presentation": {
      "description": "PROPOSED. Client-visual only. The server walk authority ignores this object.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authority",
        "default_weather",
        "day_night"
      ],
      "properties": {
        "status": {
          "const": "proposed"
        },
        "authority": {
          "const": "client_visual"
        },
        "default_weather": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$"
          }
        },
        "day_night": {
          "type": "boolean"
        }
      }
    },
    "decor": {
      "type": "array",
      "description": "Optional walk-through clutter. Never blocks, never changes pathing. type is a decor sprite id.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
