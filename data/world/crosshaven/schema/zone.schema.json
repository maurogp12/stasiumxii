{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stasiumxii.local/schemas/zone.v1.json",
  "title": "Stasium open-world zone chunk",
  "description": "Format stasium.zone version 1. Engine-agnostic chunk used by the Godot client and the authoritative server. Tile type ids and prop type ids are the sprite names. Footprints are in grid tiles, origin at the northwest cell, +x east, +y south. Water and cliff are tile types (one cell each), not props.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "zone_id",
    "region",
    "width",
    "height",
    "spawn",
    "points_of_interest",
    "exits",
    "props",
    "tiles"
  ],
  "$defs": {
    "tileCatalog": {
      "description": "Stable terrain sprite ids. walkable is required for that id.",
      "const": [
        {"id": "golden_plains", "walkable": true, "footprint": "1x1 cell"},
        {"id": "dirt_road", "walkable": true, "footprint": "1x1 cell"},
        {"id": "water", "walkable": false, "footprint": "1x1 cell"},
        {"id": "cliff", "walkable": false, "footprint": "1x1 cell"}
      ]
    },
    "propCatalog": {
      "description": "Stable prop sprite ids. footprint offsets are relative to origin. Every listed prop blocks those tiles.",
      "const": [
        {"id": "tree", "blocks": true, "footprint": [[0, 0]]},
        {"id": "fence", "blocks": true, "footprint": [[0, 0]]},
        {"id": "red_roof_cottage", "blocks": true, "footprint": [[0, 0], [1, 0], [0, 1], [1, 1]]},
        {"id": "northgate_spire", "blocks": true, "footprint": [[0, 0], [1, 0], [0, 1], [1, 1]]},
        {"id": "stoneford_spire", "blocks": true, "footprint": [[0, 0], [1, 0], [0, 1], [1, 1]]},
        {"id": "eastmarch_spire", "blocks": true, "footprint": [[0, 0], [1, 0], [0, 1], [1, 1]]},
        {"id": "westwatch_spire", "blocks": true, "footprint": [[0, 0], [1, 0], [0, 1], [1, 1]]},
        {"id": "southbridge_spire", "blocks": true, "footprint": [[0, 0], [1, 0], [0, 1], [1, 1]]},
        {"id": "crossroads_centerpiece", "blocks": true, "footprint": [[0, 0], [1, 0], [0, 1], [1, 1]]}
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0}
      }
    }
  },
  "properties": {
    "format": {"const": "stasium.zone"},
    "format_version": {"const": 1},
    "zone_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable chunk id. Crosshaven files use the crosshaven_ prefix."
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "width": {"type": "integer", "minimum": 1, "maximum": 128},
    "height": {"type": "integer", "minimum": 1, "maximum": 128},
    "spawn": {"$ref": "#/$defs/cell"},
    "points_of_interest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "x", "y"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["town", "crossroads", "landmark"]},
          "x": {"type": "integer", "minimum": 0},
          "y": {"type": "integer", "minimum": 0}
        }
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "edge", "target_zone", "links"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "edge": {"enum": ["north", "south", "east", "west"]},
          "target_zone": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": {"$ref": "#/$defs/cell"},
                "to": {"$ref": "#/$defs/cell"}
              }
            }
          }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "blocks", "origin", "footprint"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Instance id, unique inside the chunk. Not the sprite name."
          },
          "type": {
            "description": "Sprite id. Must be a propCatalog id. Footprint cells must equal origin plus that id's offsets.",
            "enum": [
              "tree",
              "fence",
              "red_roof_cottage",
              "northgate_spire",
              "stoneford_spire",
              "eastmarch_spire",
              "westwatch_spire",
              "southbridge_spire",
              "crossroads_centerpiece"
            ]
          },
          "blocks": {"const": true},
          "origin": {"$ref": "#/$defs/cell"},
          "footprint": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/cell"}
          }
        }
      }
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "description": "Row-major, y then x, one record per cell. Length must equal width * height.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "terrain", "walkable", "height"],
        "properties": {
          "x": {"type": "integer", "minimum": 0},
          "y": {"type": "integer", "minimum": 0},
          "terrain": {
            "enum": ["golden_plains", "dirt_road", "water", "cliff"]
          },
          "walkable": {"type": "boolean"},
          "height": {
            "type": "integer",
            "minimum": 0,
            "description": "Height in steps. One step is 10 px in BoardVisualSort. Not pixels."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"terrain": {"enum": ["golden_plains", "dirt_road"]}},
              "required": ["terrain"]
            },
            "then": {"properties": {"walkable": {"const": true}}}
          },
          {
            "if": {
              "properties": {"terrain": {"enum": ["water", "cliff"]}},
              "required": ["terrain"]
            },
            "then": {"properties": {"walkable": {"const": false}}}
          }
        ]
      }
    },
    "presentation": {
      "description": "PROPOSED. Client-visual only. The server walk authority ignores this object.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority", "default_weather", "day_night"],
      "properties": {
        "status": {"const": "proposed"},
        "authority": {"const": "client_visual"},
        "default_weather": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z_]*$"}
        },
        "day_night": {"type": "boolean"}
      }
    }
  }
}
