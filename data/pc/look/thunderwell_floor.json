    "grid_convention": "cell (i,j) drawn at screen x = (i-j)*64, y = (i+j)*32 (2x px); neighbour across NE = (i, j-1), SE = (i+1, j), SW = (i, j+1), NW = (i-1, j)",
    "flip_h": "mirror x (texture column c -> 127-c): NE<->NW, SE<->SW",
    "flip_v": "mirror y (row r -> 63-r): NE<->SE, NW<->SW",
    "orientation_coverage": {
      "c straight": "both axes (none: NW-SE, h: NE-SW)",
      "e T": "all four (missing SW / SE / NE / NW)",
      "f end": "all four",
      "g cross": "n/a",
      "d bend": "top corner NW+NE (none/h) and bottom corner SW+SE (v/hv)",
      "h side bend": "right corner NE+SE (none/v) and left corner NW+SW (h/hv)",
      "turns": "every 90 deg turn is covered: d + flips for top/bottom corners, h + flips for left/right corners"
    },
    "route_rule": "pick the slot/flip whose ports_by_flip equals the set of neighbours the route connects to; plain cells use a and b only"
