+static func _placed(spec: Dictionary, key: String) -> Dictionary:
+	var raw: Variant = spec.get(key, {})
+	if not (raw is Dictionary):
+		return {}
+	var c: Array = (raw as Dictionary).get("center", [])
+	var s: Array = (raw as Dictionary).get("world_size", [])
+	if c.size() < 2 or s.size() < 2:
+		return {}
+	return {"center": Vector2(float(c[0]), float(c[1])), "size": Vector2(float(s[0]), float(s[1])), "z": int((raw as Dictionary).get("z", -1))}
+
