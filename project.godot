; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="stasiumxii"
run/main_scene="res://scenes/mobile_hub.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CombatSim="*res://backend/combat_sim.gd"
EventBus="*res://backend/event_bus.gd"
NetSession="*res://backend/net_session.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

environment/defaults/default_clear_color=Color(0.008, 0.028, 0.07, 1)
; Desktop and headless stay Forward+. Phones use the Mobile renderer.
; Compatibility is the fallback only if a device cannot boot Vulkan; it is
; not the project default. See docs/tech_art_audit.md.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
; Painted 2x sheets are shown at half scale. Linear is the downsample.
; Nearest would crunch them. Mipmaps stay off on the character imports.
textures/canvas_textures/default_texture_filter=1

[stasium]

debug/show_tile_labels=false
debug/dev_overlays=false
view/reduce_shake=false
